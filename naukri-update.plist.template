<?xml version="1.0" encoding="UTF-8"?>
<!--
  LaunchAgent TEMPLATE (safe to commit, contains no personal paths).
  Do NOT edit the paths by hand. Install with:
      ./scripts/install-launchagent.sh
  which renders this file with your checkout's absolute paths into
  ~/Library/LaunchAgents/ and loads it.

  A visible browser window is expected each run (headless is blocked by Akamai).
-->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>__LABEL__</string>

    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>__RUN_SH__</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__WORKDIR__</string>

    <key>StartCalendarInterval</key>
    <dict>
      <key>Hour</key><integer>10</integer>
      <key>Minute</key><integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>__WORKDIR__/artifacts/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__WORKDIR__/artifacts/launchd.err.log</string>

    <key>RunAtLoad</key>
    <false/>
  </dict>
</plist>
