# ─────────────────────────────────────────────────────────────────────────
#  Naukri auto-update: configuration
#  Copy this file to .env and fill in your values.
#  NEVER commit .env: it holds your password and is git-ignored.
#  (./run.sh creates .env for you automatically on the first run.)
# ─────────────────────────────────────────────────────────────────────────

# ── REQUIRED ──────────────────────────────────────────────────────────────
NAUKRI_EMAIL=you@example.com
NAUKRI_PASSWORD=your-naukri-password

# ── OPTIONAL ──────────────────────────────────────────────────────────────

# Which browser to drive. Each uses its OWN isolated profile folder inside this
# project: your real Chrome/Edge profiles are never opened or modified.
#   chromium = Playwright's bundled Chromium (default; no system browser needed)
#   chrome   = your installed Google Chrome
#   msedge   = your installed Microsoft Edge
NAUKRI_BROWSER=chromium

# Which resume to upload. Leave BOTH blank to auto-use the newest PDF in ./resume/.
# On the first run, if ./resume/ is empty you'll be asked for the absolute path to
# your PDF; it is copied into ./resume/ and reused automatically afterwards.
#   NAUKRI_RESUME_PATH = an explicit path (absolute, or relative to this folder)
#   NAUKRI_RESUME_NAME = a specific filename already inside ./resume/
#NAUKRI_RESUME_PATH=
#NAUKRI_RESUME_NAME=

# Verbose logging + full Python tracebacks on error (set to 1 when debugging).
#NAUKRI_DEBUG=0

# Also write the run log to this file (relative paths land under artifacts/).
#NAUKRI_LOG_FILE=run.log

# Auto-delete screenshots/logs in artifacts/ older than N days.
#NAUKRI_ARTIFACT_RETENTION_DAYS=14

# ── NOTE ──────────────────────────────────────────────────────────────────
# The browser ALWAYS runs headful (a visible window appears for a few seconds).
# Headless does NOT work: Naukri's Akamai bot protection serves "Access Denied"
# to headless browsers. This is why the tool can't run on headless CI servers.
